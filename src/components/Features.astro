---
// Features — the five workbench capabilities as cards. Tags, grades, roles and
// intervals are machine readouts and stay literal in both locales.
import { useTranslations, getLangFromUrl } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));

const cards = [
  {
    id: "c1",
    tone: "ok",
    chips: ["single env password", "HMAC-signed cookie", "owner / operator", "zero keys in browser"],
  },
  {
    id: "c2",
    tone: "power",
    chips: ["approve / reject", "zeus /approval", "20s polling"],
  },
  {
    id: "c3",
    tone: "data",
    chips: ["orders · refunds · content", "net amount only", "no cost data"],
  },
  {
    id: "c4",
    tone: "plasma",
    chips: ["Feishu / WeChat / email", "approval deep links", "notify-only IM"],
  },
  {
    id: "c5",
    tone: "warn",
    chips: ["D3 listing: owner-only", "D2 refunds: both roles", "manual stock adjust", "via commerce endpoints"],
  },
];
---

<section id="capabilities">
  <div class="shell">
    <span class="stencil">{t("features.stencil")}</span>
    <h2 class="h-sec">{t("features.title")}</h2>
    <p class="sub-sec">{t("features.sub")}</p>

    <div class="cards">
      {cards.map((c) => (
        <article class={`card card--${c.tone}`}>
          <div class="card__head">
            <span class="card__tag">{t(`features.${c.id}.tag` as any)}</span>
          </div>
          <h3 class="card__name">{t(`features.${c.id}.name` as any)}</h3>
          <p class="card__body">{t(`features.${c.id}.body` as any)}</p>
          <ul class="card__chips">
            {c.chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="cards__footnote">{t("features.footnote")}</p>
  </div>
</section>

<style>
  .cards {
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 20px 20px 22px;
    background: linear-gradient(180deg, var(--steel-800), var(--steel-850));
    border: 1px solid var(--steel-600);
    box-shadow: var(--bevel);
  }
  .card--ok { border-top: 2px solid var(--ok); }
  .card--data { border-top: 2px solid var(--data); }
  .card--power { border-top: 2px solid var(--power); }
  .card--plasma { border-top: 2px solid var(--plasma); }
  .card--warn { border-top: 2px solid var(--warn); }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .card__tag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }
  .card--ok .card__tag { color: var(--ok); }
  .card--data .card__tag { color: var(--data); }
  .card--power .card__tag { color: var(--power); }
  .card--plasma .card__tag { color: var(--plasma); }
  .card--warn .card__tag { color: var(--warn); }
  .card__name {
    margin-top: 13px;
    font-size: 18px;
  }
  .card__body {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-dim);
    flex: 1;
  }
  .card__chips {
    margin: 14px 0 0;
    padding: 13px 0 0;
    border-top: 1px dashed var(--steel-600);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card__chips li {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    padding: 3px 8px;
    background: var(--steel-900);
    border: 1px solid var(--steel-700);
  }

  .cards__footnote {
    margin: 22px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ink-faint);
  }

  @media (max-width: 980px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
