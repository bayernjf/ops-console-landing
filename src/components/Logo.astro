---
// Logo — the ops-console mark: the family steel hexagon with three stacked
// layers (two data-cyan on top, the amber operating base below), overstamped
// with an amber check — the human sign-off that this workbench exists for.
const { size = 32 } = Astro.props;
---

<span class="logo" style={`--logo-size: ${size}px`} aria-label="ops-console" role="img">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M16 2.2 28.1 8.5v13L16 29.8 3.9 21.5v-13z"
      fill="var(--steel-800)"
      stroke="var(--steel-400)"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
    <path
      d="M16 7.1 23.5 11v8L16 22.9 8.5 19v-8z"
      fill="none"
      stroke="var(--data)"
      stroke-width="1"
      opacity=".5"
    />
    <g>
      <!-- upper layers (two data-cyan bars) -->
      <rect x="12" y="10.8" width="8" height="1.9" rx=".3" fill="var(--data)" opacity=".45" />
      <rect x="10.2" y="14" width="11.6" height="1.9" rx=".3" fill="var(--data)" opacity=".75" />
      <!-- amber operating base layer -->
      <rect x="8.4" y="17.3" width="15.2" height="2.3" rx=".4" fill="var(--power)" />
      <!-- human sign-off stamp over the stack -->
      <path
        d="M11.8 13.6l2.8 3 5.6-5.8"
        stroke="var(--steel-950)"
        stroke-width="3.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M11.8 13.6l2.8 3 5.6-5.8"
        stroke="var(--power)"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </g>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-size, 32px);
    height: var(--logo-size, 32px);
    flex: none;
  }
  .logo svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 10px rgba(255, 176, 32, 0.12));
  }
</style>
